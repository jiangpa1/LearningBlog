# ══════════════════════════════════════════════════════════════════════
#  docker compose 用的环境变量模板
#
#  用法：复制成 .env 再填真实值
#      cp .env.example .env      （Windows: copy .env.example .env）
#
#  ⚠️ .env 已被 .gitignore 忽略，**不要提交**
#  ⚠️ 这里的口令只作用于【容器里的新库】，和你虚拟机上那个库无关，可以完全不同
# ══════════════════════════════════════════════════════════════════════

# MySQL root 口令（容器内新库的）
MYSQL_ROOT_PASSWORD=

# Redis 口令
REDIS_PASSWORD=

# JWT 签名密钥：**至少 32 个字符**，短了启动会抛 WeakKeyException
# 生成方式（PowerShell）：
#   (1..32 | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) }) -join ''
JWT_SECRET=
