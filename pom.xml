<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
    </parent>

    <groupId>com.jiangpa</groupId>
    <artifactId>Learning</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Learning</name>
    <url>http://maven.apache.org</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>17</java.version>
    </properties>

    <dependencies>


        <!--引入web场景启动器-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--    测试启动器     -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--    MyBatis   -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>3.5.5</version>
        </dependency>

        <!--    MySQL 驱动：Spring Boot 2.7.8 起管理的坐标是 com.mysql:mysql-connector-j，
                旧的 mysql:mysql-connector-java 已不在 dependencyManagement 中，不能省略版本号    -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!--        redis       -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>


        <!--    lombok     -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>


        <!-- 参数校验 Starter（包含 @NotBlank, @NotNull, @Size 等全套校验注解） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>


        <!-- JJWT 核心依赖 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!--        bcrypt加密        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>


        <!--    接口文档：Knife4j（基于 springdoc 的 OpenAPI 3 增强 UI）
                ⚠️ 坐标是这个，别抄成 knife4j-openapi3-jakarta-spring-boot-starter ——
                   那个是给 Spring Boot 3 / jakarta 用的，本项目是 2.7 / javax，会直接起不来。
                它的底层是 springdoc-openapi-ui 1.6.x（不是 springfox）——
                   springfox 3.0 在 Spring Boot 2.6+ 会因为默认路径匹配改成 PathPatternParser 而报
                   "Failed to start bean documentationPluginsBootstrapper"，springdoc 没这个问题。    -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-spring-boot-starter</artifactId>
            <version>4.5.0</version>
        </dependency>


    </dependencies>

    <build>
        <plugins>
            <!--
              ★ 必须有它，mvn package 才会产出【可执行的 fat jar】（内含 Tomcat 与全部依赖）。
                没有它时打出来的是 0.1MB 的瘦 jar，连 Main-Class 都没有，
                `java -jar` 会报 "no main manifest attribute" —— Docker 的 ENTRYPOINT 必然撞上。
                IDEA 里一直没暴露，是因为 IDEA 直接跑 main() 配 ~/.m2 的 classpath，根本没碰这个 jar。
                版本号由 spring-boot-starter-parent 统一管理，不用自己写。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
